# Copy this file to .env and fill it in. The app reads .env from the directory
# that holds app/, so run it from the repository root.

# --- Telegram API, from https://my.telegram.org/apps ------------------------
# Both are required. The app refuses to start without them.
API_ID=1234567
API_HASH=your_api_hash_here

# --- Database ---------------------------------------------------------------
# Default is a local MongoDB; point it at Atlas in production.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=saverestricted

# --- Optional ---------------------------------------------------------------
# Force users to join this channel before saving (username or -100 id)
FORCESUB=your_channel_username
# Telegram user ids allowed to reach the admin API
AUTH_USERS=7477152489

# --- Web server -------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
COOKIE_NAME=tg_web_session
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# --- Admin ------------------------------------------------------------------
# The admin types this digit-only password into the phone field on the login
# page. It is only the first-login default: the app forces a new password on
# first use and stores it hashed. Between 6 and 12 digits.
ADMIN_PIN=123456

# --- Login ------------------------------------------------------------------
# How long a browser stays signed in, seconds
TOKEN_TTL_SECONDS=2592000
# How long a pending OTP login stays valid, seconds
LOGIN_TTL_SECONDS=300
LOGIN_MAX_ATTEMPTS=5

# --- Limits -----------------------------------------------------------------
DAILY_LIMIT=20
COOLDOWN_SECONDS=0
JOB_TTL_SECONDS=3600
HISTORY_LIMIT=100
HISTORY_TTL_DAYS=30
# Disk headroom: stop accepting work when less than this much is free, bytes
FREE_SPACE_RESERVE=2147483648

# --- Batch and multi-link saves ---------------------------------------------
BULK_SAVES_PER_DAY=1
BULK_MAX_FILES=50
MULTI_SAVES_PER_DAY=2
MULTI_MAX_LINKS=5

# --- Uploading split files --------------------------------------------------
# Files bigger than this are sent as numbered parts when the account is not
# Telegram Premium.
FREE_UPLOAD_MIB=2000
PREMIUM_UPLOAD_MIB=4000

# --- Telegram call handling -------------------------------------------------
# A single Telegram call may take at most this long before it is abandoned
CALL_TIMEOUT_SECONDS=900
# A job with no progress for this long is reaped, seconds
STUCK_JOB_SECONDS=2700
