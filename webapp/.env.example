# --- Telegram API (same values the bot uses) ---
API_ID=1234567
API_HASH=your_api_hash_here

# --- Database (same DB as the bot, so sessions are shared) ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DB_NAME=saverestricted

# --- Optional ---
# Force users to join this channel before fetching (username or -100 id)
FORCESUB=your_channel_username
# Telegram user ids allowed to call /api/stats
AUTH_USERS=7477152489

# --- Web server ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# --- Limits ---
# Free fetches per user per day
DAILY_LIMIT=20
# Seconds to wait between fetches (0 = no cooldown)
COOLDOWN_SECONDS=0
# How long finished jobs (and their files) stay available, seconds
JOB_TTL_SECONDS=3600
